# =============================================================================
# 環境變數範本檔 (.env.example)
# 說明：
# 1. 此檔案「可以」安全地提交至 GitHub，並供 AI 助手讀取以了解系統所需之設定欄位。
# 2. 實際開發時，請將此檔案複製一份並重新命名為 `.env`（已被 .gitignore 忽略）。
# 3. 真實的 API Key 與密碼請只填寫在 `.env` 中，切勿直接填寫於此範本檔！
# =============================================================================

# --- 應用程式基本設定 ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- 資料庫連線設定 (請替換為本地或測試環境假資料格式) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_app_dev
DB_USER=your_db_username_here
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://user:password@localhost:5432/my_app_dev

# --- 身分驗證與加密金鑰 ---
JWT_SECRET=replace_with_a_strong_random_secret_key
SESSION_SECRET=replace_with_session_secret

# --- 第三方 API 金鑰 (請保持為佔位符，勿填入真實金鑰) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
